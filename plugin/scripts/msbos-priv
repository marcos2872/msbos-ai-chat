#!/usr/bin/env bash
# msbos-priv — helper privilegiado com LISTA PERMITIDA, chamado via pkexec.
#
# Uso (como usuário, o polkit abre a janela de senha):
#   pkexec /usr/local/libexec/msbos-priv <subcomando> [args...]
# Validar argumentos sem privilégio (sem pkexec, não altera nada):
#   /usr/local/libexec/msbos-priv --dry-run <subcomando> [args...]
#
# Subcomandos:
#   dnf-install <pacote...>          instala (sem weak deps; só repos já habilitados)
#   dnf-simulate-remove <pacote...>  simula a remoção e lista o que sairia
#   dnf-remove <pacote...>           remove (simula antes; recusa pacotes protegidos)
#   dnf-upgrade [--refresh]          atualiza o sistema (sem remover pacotes)
#   svc-enable|svc-disable|svc-restart <unidade>   só unidades da lista permitida
#   version | help
#
# Princípios:
#   • tudo que não está na lista é recusado (falha fechada);
#   • nomes validados por regex restrita (sem glob, caminho, URL ou opção);
#   • nunca remove em cascata dependências órfãs;
#   • nunca reinicia nem desliga a máquina: isso é decisão do usuário;
#   • toda ação (inclusive recusas) é registrada em /var/log/msbos/actions.log;
#   • listas extras só são lidas de arquivos de root em /etc/msbos/.
#
# A janela de senha do polkit é o portão real. Este script limita o QUE pode ser feito
# mesmo depois da senha.

set -euo pipefail
IFS=$' \t\n'
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
umask 022

readonly VERSAO="2"
readonly SELF="/usr/local/libexec/msbos-priv"
readonly LOG_DIR="/var/log/msbos"
readonly LOG_FILE="${LOG_DIR}/actions.log"
readonly CONF_DIR="/etc/msbos"
readonly LOCK_FILE="/run/msbos-priv.lock"
readonly MAX_PKGS=20
readonly MAX_REMOVE=25

DRY_RUN=0

# ─── utilitários ────────────────────────────────────────────────────────────
quem() {
  local uid nome
  uid="${PKEXEC_UID:-${SUDO_UID:-${EUID}}}"
  nome="$(getent passwd "${uid}" 2>/dev/null | cut -d: -f1 || true)"
  printf '%s(%s)' "${nome:-?}" "${uid}"
}

registra() {
  if [[ ${DRY_RUN} == 1 ]]; then return 0; fi
  {
    install -d -m 0750 "${LOG_DIR}"
    printf '%s %s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$(quem)" "$*" >> "${LOG_FILE}"
  } 2>/dev/null || true
}

die() {
  registra "DENY $*"
  printf 'msbos-priv: %s\n' "$*" >&2
  exit 2
}

# le_lista ARQUIVO — imprime linhas úteis; ignora o arquivo se não for de root
# ou se for gravável por grupo/outros.
le_lista() {
  local f="$1" dono modo
  [[ -f ${f} ]] || return 0
  dono="$(stat -c '%u' "${f}")"
  modo="$(stat -c '%a' "${f}")"
  if [[ ${dono} != 0 ]] || (( (8#${modo}) & 8#022 )); then
    printf 'msbos-priv: ignorando %s (dono ou permissões inseguros)\n' "${f}" >&2
    return 0
  fi
  sed -e 's/#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "${f}" | grep -v '^$' || true
}

usage() {
  sed -n '2,/^$/p' "${SELF}" 2>/dev/null | sed 's/^# \{0,1\}//' || true
}

# ─── pacotes ────────────────────────────────────────────────────────────────
readonly PKG_RE='^[A-Za-z0-9][A-Za-z0-9._+-]{0,99}$'

valida_pkgs() {
  (($# > 0)) || die "informe ao menos um pacote"
  (($# <= MAX_PKGS)) || die "máximo de ${MAX_PKGS} pacotes por chamada"
  local p
  for p in "$@"; do
    [[ ${p} =~ ${PKG_RE} ]] || die "nome de pacote inválido: '${p}' (sem globs, caminhos, URLs ou opções)"
  done
}

# Padrões (regex, ancorados) de pacotes que NUNCA podem ser removidos pelo helper,
# nem como alvo, nem como efeito colateral.
PROTEGIDOS_BASE=(
  # sistema base, pacotes, login, segurança, boot
  'systemd(-.*)?' 'dbus(-.*)?' 'glibc(-.*)?' 'bash' 'coreutils(-.*)?' 'filesystem' 'setup'
  'shadow-utils' 'util-linux(-.*)?' 'rpm(-.*)?' 'dnf(-.*)?' 'dnf5(-.*)?' 'libdnf5?(-.*)?'
  'python3-dnf(-.*)?' 'sudo' 'polkit(-.*)?' 'pam(-.*)?' 'selinux-policy(-.*)?'
  'libselinux(-.*)?' 'policycoreutils(-.*)?' 'kernel(-.*)?' 'grub2(-.*)?' 'shim(-.*)?'
  'dracut(-.*)?' 'fedora-(release|repos|gpg-keys)(-.*)?' 'openssl(-.*)?' 'glib2'
  'openssh-server' 'firewalld(-.*)?' 'plymouth(-.*)?'
  # stack do msbos
  'NetworkManager(-.*)?' 'greetd(-.*)?' 'niri(-.*)?' 'noctalia(-.*)?'
  'xdg-desktop-portal(-.*)?' 'pipewire(-.*)?' 'wireplumber(-.*)?' 'tuned(-.*)?'
  'tuned-ppd' 'zram-generator(-.*)?' 'jemalloc' 'udisks2(-.*)?'
  # shell e ferramentas que o projeto garante (zsh do usuário, python3 do REPL)
  'zsh' 'python3'
  # apps KDE do dia a dia (KEEP_PKGS/APP_PKGS do msbos-remove-plasma).
  # 'dolphin' é exato de propósito: 'dolphin-emu' é outro pacote (emulador) e
  # não faz parte do conjunto garantido pelo projeto.
  'dolphin' 'dolphin-plugins' 'konsole' 'kwrite' 'kate' 'okular' 'gwenview' 'ark'
  'spectacle' 'kcalc' 'kde-connect' 'kfind' 'dragon' 'elisa-player'
  'plasma-systemmonitor' 'kinfocenter'
  # suporte que mantém os apps KDE funcionando (estilo, portal, KIO, miniaturas,
  # menu XDG, agente polkit)
  'plasma-integration' 'plasma-breeze(-.*)?' 'plasma-systemsettings' 'polkit-kde'
  'breeze-(icon-theme|cursor-theme|gtk(-.*)?)'
  'kde-cli-tools' 'redhat-menus' 'kio-extras' 'kio-admin' 'kdegraphics-thumbnailers'
  'ffmpegthumbs' 'kwallet(-.*)?' 'pam-kwallet' 'kf6-kwallet(-.*)?' 'kglobalacceld'
  'kde-gtk-config' 'dconf'
  # shell do Plasma: quem o remove é o msbos-remove-plasma no boot, nunca o
  # agente na sessão viva (o %preun derruba a sessão no meio da transação)
  'plasma-desktop' 'plasmalogin'
)

eh_protegido() {
  local nome="$1" re
  for re in "${PROTEGIDOS_BASE[@]}"; do
    if [[ ${nome} =~ ^(${re})$ ]]; then return 0; fi
  done
  while IFS= read -r re; do
    [[ -n ${re} ]] || continue
    if [[ ${nome} =~ ^(${re})$ ]]; then return 0; fi
  done < <(le_lista "${CONF_DIR}/protected.list")
  return 1
}

# checa_alvos PKG... — recusa alvos protegidos ANTES de qualquer caminho, inclusive
# o --dry-run: o dry-run tem de dizer a mesma verdade que a execução real. (A cascata
# só o dnf sabe simular; essa parte continua em simula_remocao.)
checa_alvos() {
  local p
  for p in "$@"; do
    if eh_protegido "${p}"; then die "pacote protegido: '${p}' — não removo (explique ao usuário)"; fi
  done
}

# --color=never é opção global (antes do subcomando) e mantém a saída estável — o
# parsing da simulação depende dela. --no-autoremove é opção do subcomando remove
# (o dnf5 recusa se vier antes) e é o nome documentado de
# clean_requirements_on_remove=False.
readonly DNF_COLOR=(--color=never)
readonly DNF_INSTALL_OPTS=(--setopt=install_weak_deps=0)
readonly DNF_REMOVE_OPTS=(--no-autoremove)
SAI=()

# simula_remocao PKG... — preenche SAI com o que seria removido; falha fechada.
simula_remocao() {
  local sim x
  checa_alvos "$@"
  sim="$(dnf "${DNF_COLOR[@]}" remove --assumeno "${DNF_REMOVE_OPTS[@]}" "$@" 2>&1)" || true
  mapfile -t SAI < <(awk '$2 ~ /^(x86_64|noarch|i686|aarch64|src)$/ {print $1}' <<<"${sim}" | sort -u)
  if ((${#SAI[@]} == 0)); then
    printf '%s\n' "${sim}" >&2
    die "a simulação não listou pacotes a remover (pacote não instalado ou erro do dnf)"
  fi
  for x in "${SAI[@]}"; do
    if eh_protegido "${x}"; then die "a remoção levaria junto o pacote protegido '${x}' — abortado"; fi
  done
  ((${#SAI[@]} <= MAX_REMOVE)) \
    || die "a remoção afetaria ${#SAI[@]} pacotes (limite ${MAX_REMOVE}) — peça ao usuário para fazer manualmente"
}

executa() {
  if [[ ${DRY_RUN} == 1 ]]; then
    printf 'dry-run: %s\n' "$*"
    return 0
  fi
  registra "EXEC $*"
  local rc=0
  "$@" || rc=$?
  registra "RESULT rc=${rc}"
  return "${rc}"
}

cmd_dnf_install() {
  valida_pkgs "$@"
  executa dnf "${DNF_COLOR[@]}" -y "${DNF_INSTALL_OPTS[@]}" install "$@"
}

cmd_dnf_simulate_remove() {
  valida_pkgs "$@"
  checa_alvos "$@"
  if [[ ${DRY_RUN} == 1 ]]; then
    printf 'dry-run: simularia a remoção de: %s (só valido os nomes sem privilégio)\n' "$*"
    return 0
  fi
  registra "SIMULATE-REMOVE $*"
  simula_remocao "$@"
  printf 'Seriam removidos (%d): %s\n' "${#SAI[@]}" "${SAI[*]}"
}

cmd_dnf_remove() {
  valida_pkgs "$@"
  # o check de protegidos vem antes do retorno de dry-run: um "removeria dolphin"
  # no dry-run seria uma mentira sobre a segurança do comando
  checa_alvos "$@"
  if [[ ${DRY_RUN} == 1 ]]; then
    printf 'dry-run: removeria (após simulação e checagem de protegidos): %s\n' "$*"
    return 0
  fi
  simula_remocao "$@"
  printf 'Removendo (%d): %s\n' "${#SAI[@]}" "${SAI[*]}"
  executa dnf "${DNF_COLOR[@]}" remove -y "${DNF_REMOVE_OPTS[@]}" "$@"
  printf 'Para desfazer: veja o ID em "dnf history list" e rode "dnf history undo <ID>".\n'
}

# Atualizar o sistema. Sem alvos e sem opções livres: só `--refresh`
# (renova os metadados dos repositórios antes de calcular a transação).
# `dnf upgrade` não remove pacotes por padrão; a simulação existe só para o caso
# de um obsoleto levar junto algum pacote protegido.
cmd_dnf_upgrade() {
  local refresh=0 extra=""
  if (($# > 1)); then
    die "uso: dnf-upgrade [--refresh] (sem nomes de pacote)"
  fi
  if (($# == 1)); then
    if [[ ${1} != --refresh ]]; then
      die "opção inválida: '${1}' (só --refresh é aceito)"
    fi
    refresh=1
    extra=" --refresh"
  fi
  if [[ ${DRY_RUN} == 1 ]]; then
    printf 'dry-run: atualizaria o sistema com dnf upgrade%s\n' "${extra}"
    return 0
  fi

  local opts=("${DNF_COLOR[@]}")
  if ((refresh == 1)); then opts+=(--refresh); fi

  local sim
  sim="$(dnf "${opts[@]}" upgrade --assumeno 2>&1)" || true
  mapfile -t SAI < <(awk '
    /^Removing/ { dentro = 1; next }
    dentro && /^[[:space:]]*$/ { dentro = 0 }
    dentro && $2 ~ /^(x86_64|noarch|i686|aarch64|src)$/ { print $1 }
  ' <<<"${sim}" | sort -u)
  local x
  if ((${#SAI[@]} > 0)); then
    for x in "${SAI[@]}"; do
      if eh_protegido "${x}"; then
        die "a atualização removeria o pacote protegido '${x}' — abortado"
      fi
    done
  fi

  executa dnf "${opts[@]}" -y "${DNF_INSTALL_OPTS[@]}" upgrade
  printf 'Para desfazer: veja o ID em "dnf history list" e rode "dnf history undo <ID>".\n'
}

# ─── serviços ───────────────────────────────────────────────────────────────
# Unidades que o agente pode mexer. Fora de propósito:
#   • systemd-oomd  — o projeto depende dele (40-tuning.sh + oomd.conf);
#   • power-profiles-daemon — conflita com o tuned-ppd, que é o perfil do projeto;
#   • greetd/NetworkManager/systemd-*/dbus/polkit — derrubam a sessão ou o login.
readonly UNITS_BASE=(
  tuned.service tuned-ppd.service bluetooth.service
  libvirtd.service libvirtd.socket podman.socket cups.service cups.socket
  avahi-daemon.service avahi-daemon.socket fprintd.service firewalld.service
  sshd.service
)
readonly UNIT_RE='^[A-Za-z0-9][A-Za-z0-9@._-]{0,99}\.(service|socket|timer)$'
readonly SUFIXO_RE='\.(service|socket|timer)$'

valida_unit() {
  local u="$1" ok=0 b
  [[ ${u} =~ ${SUFIXO_RE} ]] || u="${u}.service"
  [[ ${u} =~ ${UNIT_RE} ]] || die "nome de unidade inválido: '${1}'"
  for b in "${UNITS_BASE[@]}"; do [[ ${b} == "${u}" ]] && ok=1; done
  if ((ok == 0)); then
    if le_lista "${CONF_DIR}/allowed-units.list" | grep -Fxq -- "${u}"; then ok=1; fi
  fi
  ((ok == 1)) || die "unidade '${u}' fora da lista permitida (/etc/msbos/allowed-units.list é só do administrador)"
  printf '%s' "${u}"
}

cmd_svc() {
  local acao="$1" u
  shift
  (($# == 1)) || die "informe exatamente uma unidade"
  u="$(valida_unit "$1")"
  case "${acao}" in
    enable)  executa systemctl enable --now -- "${u}" ;;
    disable) executa systemctl disable --now -- "${u}" ;;
    restart) executa systemctl restart -- "${u}" ;;
    *) die "ação de serviço desconhecida: ${acao}" ;;
  esac
}

# ─── principal ──────────────────────────────────────────────────────────────
main() {
  if [[ ${1:-} == --dry-run ]]; then
    DRY_RUN=1
    shift
  fi
  if (($# == 0)); then usage; exit 2; fi
  local cmd="$1"
  shift

  case "${cmd}" in
    version) echo "msbos-priv ${VERSAO}"; return 0 ;;
    help|-h|--help) usage; return 0 ;;
  esac

  if [[ ${DRY_RUN} == 0 ]]; then
    [[ ${EUID} -eq 0 ]] || die "precisa de root: use 'pkexec ${SELF} ${cmd} ...' (ou --dry-run para só validar)"
    exec 9>"${LOCK_FILE}"
    flock -n 9 || die "outra operação do msbos-priv está em andamento"
  fi

  case "${cmd}" in
    dnf-install)         cmd_dnf_install "$@" ;;
    dnf-simulate-remove) cmd_dnf_simulate_remove "$@" ;;
    dnf-remove)          cmd_dnf_remove "$@" ;;
    dnf-upgrade)         cmd_dnf_upgrade "$@" ;;
    svc-enable)          cmd_svc enable "$@" ;;
    svc-disable)         cmd_svc disable "$@" ;;
    svc-restart)         cmd_svc restart "$@" ;;
    *) die "subcomando desconhecido: ${cmd}" ;;
  esac
}

main "$@"
